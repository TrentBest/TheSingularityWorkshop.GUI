@page "/"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using BotStudioWebApp
@using TheSingularityWorkshop.Workshop.Gui
@inject IHttpClientFactory HttpClientFactory

<PageTitle>SingularityBot Studio</PageTitle>
<div class="app-frame">
  <aside class="rail"><div class="brand-mark">S</div><div class="rail-label">BOT<br />STUDIO</div><div class="rail-spacer"></div><div class="rail-indicator" title="Local web interface"></div></aside>
  <main class="workspace">
    <header class="topbar"><div><div class="eyebrow">THE SINGULARITY WORKSHOP / STARCRAFT II</div><h1>SingularityBot <span>Studio</span></h1></div><div class="connection-pill"><span class="pulse"></span> @(_connected ? "BRIDGE CONNECTED" : "BRIDGE OFFLINE")</div></header>
    <section class="hero-grid"><div class="hero-copy">
      @BlazorGuiRenderer.Render(BuildSemanticHeader())
      <p class="hero-description">A dedicated browser workspace for configuring, observing, and directing bot matches. The interface runs independently of any LLM session.</p>
      <div class="hero-note"><strong>Runtime boundary</strong><span>The dashboard uses a server-side connection to the loopback bridge. This page currently reads telemetry only; it cannot issue bot commands.</span></div>
    </div><div class="hero-orbit" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit-core">FSM</div><div class="orbit-dot"></div></div></section>
    <section class="section-heading"><div><div class="eyebrow">01 / LOCAL CONNECTION</div><h2>Connect to a running bot</h2></div><span class="section-caption">Read-only · loopback only · token held in server memory</span></section>
    <section class="panel connection-panel">
      <div class="connection-fields">
        <div><label for="bridgeAddress">Bridge address</label><input id="bridgeAddress" @bind="_bridgeAddress" disabled="@_connected" /></div>
        <div><label for="bridgeToken">Bearer token from Runner console</label><input id="bridgeToken" type="password" autocomplete="off" spellcheck="false" @bind="_bridgeToken" disabled="@_connected" placeholder="Paste the local token" /></div>
      </div>
      <div class="button-row">
        @if (!_connected)
        {
          <button class="primary" @onclick="ConnectAsync" disabled="@_connecting || string.IsNullOrWhiteSpace(_bridgeToken)">@(_connecting ? "Connecting…" : "Connect read-only") <span>↗</span></button>
        }
        else
        {
          <button class="secondary" @onclick="Disconnect">Disconnect</button>
        }
        <span class="connection-message" role="status">@_connectionMessage</span>
      </div>
      <p class="panel-footnote">The address must be exactly the local IPv4 loopback host. The token is not saved to browser storage, URLs, or application logs. Disconnecting stops dashboard polling only; it does not stop or pause the bot.</p>
    </section>
    <section class="section-heading"><div><div class="eyebrow">02 / MATCH SETUP</div><h2>Prepare a match</h2></div><span class="section-caption">Configuration only · execution disabled</span></section>
    <section class="panel-grid">
      <article class="panel setup-panel"><div class="panel-head"><div><span class="panel-kicker">BOT CONFIGURATION</span><h3>Match profile</h3></div><span class="tag">LOCAL</span></div>
        <label for="mode">Opening mode</label><select id="mode" @bind="SelectedMode"><option value="terran.marine.v1">Terran · Marine baseline</option><option value="zerg.zergling.v1">Zerg · Zergling experimental</option></select>
        <label for="map">Map</label><input id="map" @bind="MapName" />
        <div class="two-fields"><div><label for="opponent">Opponent</label><select id="opponent" @bind="Opponent"><option>Random</option><option>Terran</option><option>Zerg</option><option>Protoss</option></select></div><div><label for="difficulty">Difficulty</label><select id="difficulty" @bind="Difficulty"><option>VeryEasy</option><option>Easy</option><option>Medium</option><option>Hard</option></select></div></div>
        <div class="button-row"><button class="primary" disabled title="Match-start commands are not part of the read-only bridge">Launch match <span>↗</span></button><span class="disabled-reason">Command surface not implemented</span></div>
      </article>
      <article class="panel status-panel"><div class="panel-head"><div><span class="panel-kicker">RUNTIME STATUS</span><h3>Bot connection</h3></div><span class="status-dot @(_connected ? "online" : "offline")"></span></div>
        <div class="status-main"><div class="status-symbol">@(_connected ? "✓" : "×")</div><div><strong>@(_connected ? "Connected · read-only" : "Not connected")</strong><p>@(_connected ? "Authenticated local snapshot polling" : "Waiting for SingularityBot local host")</p></div></div>
        <div class="status-list"><div><span>Web interface</span><strong class="good">RUNNING</strong></div><div><span>Bridge health</span><strong class="@(_connected ? "good" : "")">@(_connected ? "HEALTHY" : "NOT CHECKED")</strong></div><div><span>Bot lifecycle</span><strong>@(_snapshot?.Lifecycle ?? "NOT OBSERVED")</strong></div><div><span>Telemetry</span><strong class="@(_snapshot is not null ? "good" : "")">@(_snapshot is not null ? "LIVE SNAPSHOT" : "NOT CONNECTED")</strong></div></div>
        <p class="panel-footnote">The bot remains authoritative for SC2 state and gameplay. A lost UI connection cannot terminate or pause the bot.</p>
      </article>
    </section>
    <section class="section-heading lower-heading"><div><div class="eyebrow">03 / OBSERVABILITY</div><h2>Match workspace</h2></div><span class="section-caption">@(_snapshot is null ? "Awaiting authenticated snapshot" : $"Snapshot #{_snapshot.Sequence} · {_snapshot.CapturedAtUtc.ToLocalTime():T}")</span></section>
    <section class="panel-grid lower-grid">
      <article class="panel telemetry-panel"><div class="panel-head"><div><span class="panel-kicker">MATCH TELEMETRY</span><h3>Game state</h3></div><span class="tag muted">@(_snapshot is null ? "AWAITING DATA" : "LIVE")</span></div>
        @if (_snapshot is null)
        {
          <div class="telemetry-empty"><div class="empty-glyph">⌁</div><strong>No match telemetry</strong><span>Connect with the Runner token to read the latest bot snapshot.</span></div>
        }
        else
        {
          <div class="metrics-grid">
            <div><span>Game loop</span><strong>@_snapshot.GameLoop</strong></div><div><span>Phase</span><strong>@_snapshot.GamePhase</strong></div>
            <div><span>Race actual</span><strong>@_snapshot.ActualRace</strong></div><div><span>Active mode</span><strong>@_snapshot.ActiveModeId</strong></div>
            <div><span>Minerals</span><strong>@_snapshot.Minerals</strong></div><div><span>Vespene</span><strong>@_snapshot.Vespene</strong></div>
            <div><span>Supply</span><strong>@_snapshot.FoodUsed / @_snapshot.FoodCap</strong></div><div><span>Workers</span><strong>@_snapshot.VisibleWorkers</strong></div>
            <div><span>Friendly units</span><strong>@_snapshot.VisibleFriendlyUnits</strong></div><div><span>Visible enemies</span><strong>@_snapshot.VisibleEnemyUnits</strong></div>
            <div><span>Build jobs</span><strong>@_snapshot.BuildJobCount</strong></div><div><span>Strategic jobs</span><strong>@_snapshot.StrategicJobCount</strong></div>
          </div>
        }
      </article>
      <article class="panel events-panel"><div class="panel-head"><div><span class="panel-kicker">EVENT STREAM</span><h3>Recent activity</h3></div><span class="tag muted">NOT IMPLEMENTED</span></div><div class="event-empty">Structured event streaming is a separate milestone. No events are fabricated.</div></article>
    </section>
    <footer><span>THE SINGULARITY WORKSHOP</span><span>BOT STUDIO · DEVELOPMENT PREVIEW</span></footer>
  </main>
</div>
@code {
  private string SelectedMode { get; set; } = "terran.marine.v1";
  private string MapName { get; set; } = "AcolyteLE.SC2Map";
  private string Opponent { get; set; } = "Random";
  private string Difficulty { get; set; } = "VeryEasy";
  private string _bridgeAddress = "http://127.0.0.1:43127";
  private string _bridgeToken = "";
  private string _connectionMessage = "Bridge is disconnected.";
  private bool _connecting;
  private bool _connected;
  private BotStudioSnapshotDto? _snapshot;
  private CancellationTokenSource? _pollCancellation;

  private static GuiNode BuildSemanticHeader() => GuiBuilder.Create("Panel", "bot-studio-semantic-header").Child("Text", "bot-studio-title", title => title.Text("BOT CONTROL / OBSERVABILITY")).Build();

  private async Task ConnectAsync()
  {
    if (_connecting || _connected) return;
    _connecting = true;
    _connectionMessage = "Checking local bridge…";
    try
    {
      if (!Uri.TryCreate(_bridgeAddress, UriKind.Absolute, out var baseUri) ||
          baseUri.Scheme != Uri.UriSchemeHttp ||
          baseUri.Host != "127.0.0.1" ||
          baseUri.Port is < 1 or > 65535 ||
          baseUri.UserInfo.Length != 0 || baseUri.Query.Length != 0 || baseUri.Fragment.Length != 0 ||
          !baseUri.AbsolutePath.TrimEnd('/').Equals("", StringComparison.Ordinal))
      {
        _connectionMessage = "Use http://127.0.0.1 with the Runner bridge port.";
        return;
      }

      using var client = HttpClientFactory.CreateClient();
      client.Timeout = TimeSpan.FromSeconds(4);
      var health = await client.GetAsync(new Uri(baseUri, "/api/health"));
      if (!health.IsSuccessStatusCode)
      {
        _connectionMessage = $"Bridge health check failed ({(int)health.StatusCode}).";
        return;
      }

      using var request = new HttpRequestMessage(HttpMethod.Get, new Uri(baseUri, "/api/snapshot"));
      request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", _bridgeToken.Trim());
      using var response = await client.SendAsync(request);
      if (!response.IsSuccessStatusCode)
      {
        _connectionMessage = response.StatusCode == System.Net.HttpStatusCode.Unauthorized
          ? "Token rejected. Check the Runner console and try again."
          : $"Snapshot unavailable ({(int)response.StatusCode}). Start a bot session, then reconnect.";
        return;
      }

      _snapshot = await response.Content.ReadFromJsonAsync<BotStudioSnapshotDto>();
      if (_snapshot is null)
      {
        _connectionMessage = "Bridge returned an empty snapshot.";
        return;
      }

      _connected = true;
      _connectionMessage = "Authenticated. Refreshing read-only telemetry every 2 seconds.";
      _pollCancellation = new CancellationTokenSource();
      _ = PollSnapshotsAsync(baseUri, _bridgeToken.Trim(), _pollCancellation.Token);
    }
    catch (OperationCanceledException)
    {
      _connectionMessage = "Bridge request timed out.";
    }
    catch (HttpRequestException)
    {
      _connectionMessage = "Cannot reach 127.0.0.1. Confirm Runner is active with --studio-bridge.";
    }
    finally
    {
      _connecting = false;
    }
  }

  private async Task PollSnapshotsAsync(Uri baseUri, string token, CancellationToken cancellationToken)
  {
    using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
    try
    {
      while (await timer.WaitForNextTickAsync(cancellationToken))
      {
        using var client = HttpClientFactory.CreateClient();
        client.Timeout = TimeSpan.FromSeconds(4);
        using var request = new HttpRequestMessage(HttpMethod.Get, new Uri(baseUri, "/api/snapshot"));
        request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
        using var response = await client.SendAsync(request, cancellationToken);
        if (!response.IsSuccessStatusCode)
          throw new HttpRequestException($"Snapshot request failed: {(int)response.StatusCode}.");
        var snapshot = await response.Content.ReadFromJsonAsync<BotStudioSnapshotDto>(cancellationToken: cancellationToken);
        if (snapshot is null) throw new HttpRequestException("Snapshot response was empty.");
        await InvokeAsync(() => { _snapshot = snapshot; StateHasChanged(); });
      }
    }
    catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
    catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
    {
      await InvokeAsync(() =>
      {
        _connected = false;
        _snapshot = null;
        _bridgeToken = "";
        _connectionMessage = "Telemetry connection lost. Reconnect manually; the bot continues independently.";
        StateHasChanged();
      });
    }
  }

  private void Disconnect()
  {
    _pollCancellation?.Cancel();
    _pollCancellation?.Dispose();
    _pollCancellation = null;
    _connected = false;
    _snapshot = null;
    _bridgeToken = "";
    _connectionMessage = "Disconnected. Bot process is unaffected.";
  }

  public ValueTask DisposeAsync()
  {
    _pollCancellation?.Cancel();
    _pollCancellation?.Dispose();
    return ValueTask.CompletedTask;
  }
}
