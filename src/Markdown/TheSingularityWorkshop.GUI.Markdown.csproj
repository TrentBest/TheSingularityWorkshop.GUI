<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TheSingularityWorkshop.Workshop.Gui.Markdown</RootNamespace>
    <PackageId>TheSingularityWorkshop.GUI.Markdown</PackageId>
    <Version>0.1.0</Version>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>gui;markdown;badges;documents;presentation</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Authors>The Singularity Workshop</Authors>
    <Company>The Singularity Workshop</Company>
    <RepositoryUrl>https://github.com/TrentBest/TheSingularityWorkshop.GUI</RepositoryUrl>
    <PackageDescription>Markdown adapter for renderer-neutral semantic GUI badge compositions.</PackageDescription>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/TheSingularityWorkshop.GUI.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
